  "scripts": {
    "dev": "NODE_ENV=development node --watch --experimental-transform-types src/index.ts",
    "start": "NODE_ENV=production node  --experimental-transform-types src/index.ts",
    "outbox:dev": "NODE_ENV=development node  --watch --experimental-transform-types src/workers/outbox.worker.ts",
